# Vantage · .gitattributes
# ------------------------------------------------------------------
# Everyone who clones this repository should get identical bytes, on any
# platform, and GitHub should describe the generated bundle honestly.

* text=auto eol=lf

# Windows binaries that open the project (Rojo / Studio) read LF fine, but
# scripts that users paste into an executor must never arrive with CRLF.
*.luau text eol=lf
*.lua text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Generated by tools/bundle.mjs — do not expect review diffs here.
dist/Vantage.luau linguist-generated=true
dist/Vantage.min.luau linguist-generated=true
tests/build/** linguist-generated=true

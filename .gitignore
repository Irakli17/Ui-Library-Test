# Downloaded toolchain — installed by tools/install-toolchain.sh, never vendored.
/.tools/

# Generated: the test runner writes the assembled suites here.
/tests/build/

# Editor / OS noise.
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
*.swp
*~

# Node is only used for the build scripts; there is no runtime dependency,
# but a stray install should never end up in the repository.
node_modules/
npm-debug.log*

# Local environment files.
.env
.env.local

# Staging copies of the root artifacts, kept here so the four published
# files can be dragged into GitHub in one go. The real files live at the
# repository root and in dist/ — never commit this folder.
/github-upload/
